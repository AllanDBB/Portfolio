{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/magiaDigital",
      "destination": "https://drive.google.com/drive/folders/128Q2V-7ENMy_LEC6uDEOq9VcnwgzG_w-",
      "permanent": false
    },
    {
      "source": "/fa",
      "destination": "https://yellow-flowers-kappa.vercel.app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
